<h1>Rails on local LLM: A Streaming Demo</h1>

<label for="model">Model:</label><br />
<select id="model">
  <% if @models.present? %>
    <% @models.each do |m| %>
      <option value="<%= m %>"><%= m %></option>
    <% end %>
  <% else %>
    <option value="">(no models found)</option>
  <% end %>
</select>

<br /><br />
<input type="checkbox" id="enable_context" /> <label for="enable_context">Enable Context(Chat Mode)</label>
<br /><br />

<label for="prompt">Prompt:</label><br />
<textarea id="prompt"
          placeholder="Ask something..."
          style="width:100%;height:120px;"></textarea><br />

<button id="send">Send</button>
<span id="status" style="margin-left: 10px;font-weight: bold"></span>

<h3>Response (streaming via POST):</h3>
<pre id="output"
     style="white-space:pre-wrap;background:#f5f5f5;padding:1rem;margin-top:1rem;"></pre>

<script>
  const promptEl = document.getElementById("prompt");
  const outputEl = document.getElementById("output");
  const sendBtn  = document.getElementById("send");
  const modelEl  = document.getElementById("model");
  const statusEl = document.getElementById("status");
  const enableContextEl = document.getElementById("enable_context");
  const conversations = [{ "role": "system", "content": "You are a helpful assistant." }]

  let thinkingInterval = null;

  function startThinking() {
    let dots = 0;
    statusEl.textContent = "🤔 Thinking";
    thinkingInterval = setInterval(() => {
      dots = (dots + 1) % 4;
      statusEl.textContent = "🤔 Thinking" + ".".repeat(dots);
    }, 400);
  }

  function stopThinking() {
    if (thinkingInterval) {
      clearInterval(thinkingInterval);
      thinkingInterval = null;
    }
    statusEl.textContent = "";
  }

  sendBtn.addEventListener("click", async () => {
    const prompt = promptEl.value.trim();
    const model  = modelEl.value;

    if (!prompt) return;

    outputEl.textContent = "";
    sendBtn.disabled = true;
    startThinking();
    conversations.push({ "role": "user", "content": prompt })
    let response = null;

    try {
      if(enableContextEl.checked){
        response = await fetch("<%= llm_chatt_path %>", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content
          },
          body: JSON.stringify({
            messages: JSON.stringify(conversations),
            model: model
          })
        });
      }
      else{
        response = await fetch("<%= llm_stream_path %>", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content
          },
          body: JSON.stringify({
            prompt: prompt,
            model: model
          })
        });
      }


      const reader  = response.body.getReader();
      const decoder = new TextDecoder();

      while (true) {
        const { value, done } = await reader.read();
        if (done){
          conversations.push({ "role": "assistant", "content": outputEl.textContent });
          break;
        }

        const chunk = decoder.decode(value);
        outputEl.textContent += chunk;
      }

    } catch (err) {
      console.error("Streaming POST error:", err);
    } finally {
      sendBtn.disabled = false;
      stopThinking();
    }
  });
</script>
